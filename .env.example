# Runtime traffic URL; use the pooled URL when your provider offers one.
DATABASE_URL="postgresql://stockflow:replace-me@localhost:5432/stockflow?schema=public"

# Prisma CLI URL for migrations. For local PostgreSQL, it can match DATABASE_URL.
# For Neon or another pooler, use the provider's direct/unpooled URL here.
DIRECT_URL="postgresql://stockflow:replace-me@localhost:5432/stockflow?schema=public"
