generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                        String   @id @default(cuid())
  name                      String   @db.VarChar(120)
  defaultLowStockThreshold  Int      @default(5)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // The MVP supports one owner per organization.
  user      User?
  products  Product[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique @db.VarChar(254)
  passwordHash   String   @db.VarChar(255)
  organizationId String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(128)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Product {
  id                    String   @id @default(cuid())
  organizationId        String
  name                  String   @db.VarChar(160)
  sku                   String   @db.VarChar(64)
  description           String?  @db.Text
  quantityOnHand        Int      @default(0)
  costPrice             Decimal? @db.Decimal(12, 2)
  sellingPrice          Decimal? @db.Decimal(12, 2)
  lowStockThreshold     Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // SKU uniqueness and the main product queries are scoped to one organization.
  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
}
